# Elastic Beanstalk ignore file
# These files won't be uploaded to AWS

# Dependencies
node_modules/

# Environment variables (set these in EB console instead)
.env
.env.local
.env.production

# Git
.git/
.gitignore

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Temporary files
tmp/
temp/
uploads/
*.tmp

# Build files
dist/
build/

# Test files
coverage/
.nyc_output/
