# Production Environment Variables Template
# Copy this to Elastic Beanstalk Configuration → Software → Environment Properties
# DO NOT commit actual values to Git!

# Server Configuration
PORT=8080

# Database (Neon PostgreSQL - Already configured!)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-calm-dawn-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT Secret (Generate a new strong secret!)
JWT_SECRET=generate-a-new-super-long-random-secret-for-production

# Redis Configuration
# Option 1: Upstash (Free tier)
REDIS_URL=rediss://default:YOUR_PASSWORD@your-instance.upstash.io:6379

# Option 2: AWS ElastiCache
# REDIS_URL=redis://your-redis-endpoint.cache.amazonaws.com:6379

# Agora (Video/Audio)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_certificate
AGORA_CUSTOMER_ID=your_customer_id
AGORA_CUSTOMER_SECRET=your_customer_secret

# Cloudinary (File Storage)
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name

# Liveblocks (Real-time Collaboration)
LIVEBLOCKS_SECRET_KEY=sk_prod_your_secret_key

# AI Services
GEMINI_API_KEY=your_gemini_api_key
ANTHROPIC_API_KEY=sk-ant-api03-your_key

# Azure Document Intelligence
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_key
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/

# Judge0 (Code Execution)
JUDGE0_API_KEY=your_judge0_key
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com

# CORS Configuration (⚠️ UPDATE THESE AFTER DEPLOYING FRONTEND!)
ALLOWED_ORIGINS=https://main.d123456789.amplifyapp.com,https://www.your-domain.com
FRONTEND_URL=https://main.d123456789.amplifyapp.com

# Other Services
GLOT_API_KEY=your_glot_key
FINNHUB_API_KEY=your_finnhub_key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://your-backend-url.elasticbeanstalk.com/api/auth/google/callback

# Azure Storage (Agora recordings)
AGORA_AZURE_BUCKET=your_bucket_name
AGORA_AZURE_ACCESS_KEY=your_access_key
AGORA_AZURE_SECRET_KEY=your_secret_key
