# Backend API URL (will be your Render deployment URL)
VITE_API_URL=http://localhost:10000

# Claude AI API Key for Document Formatting Agent
# Get your API key from: https://console.anthropic.com/
VITE_CLAUDE_API_KEY=your-claude-api-key-here

# Azure Document Intelligence API for Vision-based Resume Analysis
# Get your credentials from: https://portal.azure.com/#create/Microsoft.CognitiveServicesFormRecognizer
VITE_AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-di-key-here
VITE_AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/

# Agora Video SDK for live sessions
VITE_AGORA_APP_ID=your-agora-app-id-here

# Optional: Analytics keys
VITE_MIXPANEL_KEY=your-mixpanel-key-here